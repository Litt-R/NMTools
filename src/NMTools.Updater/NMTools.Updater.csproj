<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NMTools.Updater</RootNamespace>
    <AssemblyName>NMTools.Updater</AssemblyName>
    <Version>0.7.1</Version>
    <AssemblyVersion>0.7.1.0</AssemblyVersion>
    <FileVersion>0.7.1.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>..\NMTools.App\Assets\Branding\NMTools.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 更新器只做文件操作和一个 Win32 提示框，不依赖 WPF/WinForms，
         因此可以裁剪未引用的框架代码，把自包含体积从 ~69 MB 降到十几 MB。
         主程序做不到（WPF 不支持 trimming），所以只在更新器上启用。 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NMTools.Core\NMTools.Core.csproj" />
  </ItemGroup>
</Project>
