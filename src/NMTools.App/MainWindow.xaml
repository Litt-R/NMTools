<Window x:Class="NMTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMTools - 输入桥接"
        Width="524"
        MinWidth="524"
        MaxWidth="524"
        Height="350"
        MinHeight="350"
        MaxHeight="350"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowActivated="True"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/NMTools.App;component/Assets/Branding/NMTools.ico"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="12">
        <!-- 独立阴影层，避免阴影参与窗口拖动命中测试。 -->
        <Border Background="#0F172A"
                Opacity="0.10"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.25" ShadowDepth="5" Color="#0F172A" />
            </Border.Effect>
        </Border>
        <Border AutomationProperties.AutomationId="MainWindowRoundedSurface"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Grid Margin="22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部品牌与版本：无边框窗口的拖动区域和关闭按钮 -->
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="44"
                               Height="44"
                               Margin="0,0,12,0"
                               Source="pack://application:,,,/NMTools.App;component/Assets/Branding/dinosaur-transparent.png"
                               SnapsToDevicePixels="True" />
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="NMTools" />
                                <Border Margin="8,0,0,0"
                                        Background="#E0F2FE"
                                        Padding="6,1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="VersionText"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0369A1"
                                               Text="v0.0.0 Portable" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Background="#DCFCE7"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,5,0" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#15803D" Text="运行中" />
                            </StackPanel>
                        </Border>
                        <Button AutomationProperties.AutomationId="MainWindowCloseButton"
                                Focusable="False"
                                IsTabStop="False"
                                Margin="8,0,0,0"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                Click="OnCloseButtonClick"
                                ToolTip="隐藏到托盘" />
                    </StackPanel>
                </DockPanel>

                <!-- 中部状态与快捷键卡片 -->
                <Border AutomationProperties.AutomationId="MainWindowShortcutCard"
                        Grid.Row="1"
                        Margin="0,12,0,12"
                        Padding="16,14"
                        VerticalAlignment="Top"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="False">
                            <TextBlock AutomationProperties.AutomationId="MainWindowShortcutTitle"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       VerticalAlignment="Center"
                                       Text="全局快捷键" />
                            <Border DockPanel.Dock="Right"
                                    Background="#F1F5F9"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SyncDelayBadgeText"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Text="同步等待 400 ms" />
                            </Border>
                        </DockPanel>

                        <!-- 键盘按键展示卡片 -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12.5"
                                           FontWeight="Medium"
                                           Foreground="#475569"
                                           VerticalAlignment="Center"
                                           Text="唤起输入气泡" />
                                <WrapPanel x:Name="KeyCapContainer"
                                           Grid.Column="1"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock AutomationProperties.AutomationId="MainWindowRetryShortcutTitle"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           Foreground="#475569"
                                           VerticalAlignment="Center"
                                           Text="重试上次粘贴" />
                                <WrapPanel x:Name="RetryKeyCapContainer"
                                           Grid.Column="1"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- 简要操作指引 -->
                        <TextBlock Grid.Row="2"
                                   x:Name="ShortcutDescription"
                                   AutomationProperties.AutomationId="MainWindowShortcutDescription"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Text="在 NoMachine 远程窗口中点击目标输入框，按快捷键唤起气泡；若 NoMachine 剪贴板同步延迟导致未粘上，按重试快捷键即可直接补发。" />
                    </Grid>
                </Border>

                <!-- 底部操作按钮栏 -->
                <DockPanel Grid.Row="3"
                           LastChildFill="False"
                           Margin="0,0,0,6">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="#94A3B8"
                               Text="关闭窗口保持后台运行" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="82"
                                AutomationProperties.AutomationId="MainWindowSettingsButton"
                                Focusable="False"
                                IsTabStop="False"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="OnOpenSettingsClick"
                                Content="设置" />
                        <Button Width="98"
                                Padding="10,0"
                                AutomationProperties.AutomationId="MainWindowHideButton"
                                Focusable="False"
                                IsTabStop="False"
                                Style="{StaticResource ModernPrimaryButtonStyle}"
                                Click="OnMinimizeToTrayClick"
                                Content="隐藏到托盘" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
