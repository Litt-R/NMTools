<Window x:Class="NMTools.App.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMTools - 发现新版本"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="UpdateAvailableDialog"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="12">
        <Border CornerRadius="12" Background="#0F172A" Opacity="0.10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.25" ShadowDepth="4" Color="#0F172A" />
            </Border.Effect>
        </Border>
        <Border Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,20"
                SnapsToDevicePixels="True">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#EFF6FF" Margin="0,0,10,0">
                        <TextBlock Text="↑"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HeaderText"
                               AutomationProperties.AutomationId="UpdateDialogHeadline"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"
                               Text="发现新版本" />
                </StackPanel>

                <Border Margin="0,4,0,0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">
                    <ScrollViewer MaxHeight="240"
                                  Padding="12,10"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="NotesText"
                                   AutomationProperties.AutomationId="UpdateDialogNotes"
                                   FontSize="12.5"
                                   Foreground="#334155"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Text="更新说明" />
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="SizeText"
                           AutomationProperties.AutomationId="UpdateDialogSize"
                           Margin="0,8,0,0"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="LaterButton"
                            AutomationProperties.AutomationId="UpdateLaterButton"
                            Width="88"
                            Padding="0"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnLaterClick"
                            Content="以后再说" />
                    <Button x:Name="DownloadButton"
                            AutomationProperties.AutomationId="UpdateDownloadButton"
                            Width="108"
                            Padding="0"
                            Style="{StaticResource ModernPrimaryButtonStyle}"
                            IsDefault="True"
                            Click="OnDownloadClick"
                            Content="下载并更新" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
