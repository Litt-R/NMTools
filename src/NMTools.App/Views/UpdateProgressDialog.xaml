<Window x:Class="NMTools.App.Views.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMTools - 下载更新"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="UpdateProgressDialog"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="12">
        <Border CornerRadius="12" Background="#0F172A" Opacity="0.10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.25" ShadowDepth="4" Color="#0F172A" />
            </Border.Effect>
        </Border>
        <Border Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,20"
                SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           AutomationProperties.AutomationId="UpdateProgressHeader"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Text="正在下载更新…" />

                <TextBlock x:Name="StatusText"
                           AutomationProperties.AutomationId="UpdateProgressStatus"
                           Margin="0,8,0,0"
                           FontSize="12.5"
                           Foreground="#475569"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Text="正在连接 GitHub…" />

                <!-- 进度条：不确定阶段用 Marquee，确定阶段用实际百分比 -->
                <ProgressBar x:Name="Progress"
                             AutomationProperties.AutomationId="UpdateProgressBar"
                             Margin="0,14,0,0"
                             Height="8"
                             IsIndeterminate="True"
                             Minimum="0"
                             Maximum="100"
                             Foreground="#2563EB"
                             Background="#E2E8F0"
                             BorderThickness="0" />

                <TextBlock x:Name="DetailText"
                           AutomationProperties.AutomationId="UpdateProgressDetail"
                           Margin="0,8,0,0"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Text="" />

                <!-- 下载完成后才显示的动作区 -->
                <StackPanel x:Name="ActionPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock AutomationProperties.AutomationId="UpdateReadyMessage"
                               FontSize="12.5"
                               Foreground="#334155"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Text="更新包已下载并校验完成。可以立即重启完成更新，也可以留到下次启动时自动应用。" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="LaterButton"
                                AutomationProperties.AutomationId="UpdateInstallLaterButton"
                                Width="140"
                                Padding="0"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="OnInstallLaterClick"
                                Content="下次启动时更新" />
                        <Button x:Name="RestartButton"
                                AutomationProperties.AutomationId="UpdateRestartNowButton"
                                Width="128"
                                Padding="0"
                                Style="{StaticResource ModernPrimaryButtonStyle}"
                                IsDefault="True"
                                Click="OnRestartNowClick"
                                Content="立即重启更新" />
                    </StackPanel>
                </StackPanel>

                <!-- 进行中只给取消，避免用户误以为能立刻关掉 -->
                <StackPanel x:Name="CancelPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton"
                            AutomationProperties.AutomationId="UpdateCancelButton"
                            Width="88"
                            Padding="0"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            IsCancel="True"
                            Click="OnCancelClick"
                            Content="取消" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
